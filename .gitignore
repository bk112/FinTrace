# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# Local configuration and secrets
.env
.env.*
!/.env.example

# ---- Data policy ----
# 数据全部入库保留。唯一例外：超过 GitHub 100 MB 单文件限制的大文件
# (data/kb/*.index) 走 Git LFS，规则见 .gitattributes，不入普通对象库。
# data/FinanceComplexQA 是子模块，由父仓库跟踪其 commit 指针。

# Reproducible run outputs, models, and experiment logs
artifacts/checkpoints/*
!artifacts/checkpoints/.gitignore
artifacts/rollouts/*
!artifacts/rollouts/.gitignore
artifacts/reports/*
!artifacts/reports/.gitignore
wandb/

# OS and editor files
.DS_Store
.idea/
.vscode/

# Leftover of a nested repository (docs/参考内容/Search-R1/.git was renamed,
# keeping the working tree only). Safe to delete locally at any time.
**/.git_disabled/
